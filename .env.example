# Local development only. `make env` copies this to .env with random secrets.

# docker-compose services
POSTGRES_OWNER_PASSWORD=__PG_OWNER__
WARDEN_APP_PASSWORD=__PG_APP__
REDIS_PASSWORD=__REDIS__
KEYCLOAK_ADMIN_PASSWORD=__KC__

# Warden (WARDEN_ prefix, "__" = nesting; any secret may be "file:/path")
WARDEN_APP__ENV=local
WARDEN_LOG__LEVEL=info
WARDEN_LOG__FORMAT=text
WARDEN_SERVER__HOST=127.0.0.1
WARDEN_SERVER__PORT=8010
WARDEN_DATABASE__DSN=postgres://warden_app:__PG_APP__@localhost:5432/warden?sslmode=disable
WARDEN_MIGRATE__DSN=postgres://warden_owner:__PG_OWNER__@localhost:5432/warden?sslmode=disable
WARDEN_OIDC__ISSUER=http://localhost:8180/realms/warden
WARDEN_OIDC__AUDIENCE=warden-api
# Roles that must sign in with a second factor (default: org_admin,security_lead).
# The dev Keycloak realm has no OTP configured, so the rule is off locally.
# Never leave this empty in production.
WARDEN_OIDC__REQUIRE_MFA_ROLES=
WARDEN_STORAGE__ENDPOINT=http://localhost:8333
WARDEN_STORAGE__BUCKET=warden-uploads
WARDEN_STORAGE__ACCESS_KEY=__S3_KEY__
WARDEN_STORAGE__SECRET_KEY=__S3_SECRET__
WARDEN_SMTP__HOST=localhost
WARDEN_SMTP__PORT=1025
WARDEN_SMTP__FROM=warden@localhost
WARDEN_SMTP__PUBLIC_BASE_URL=http://localhost:5173
WARDEN_SCAN__HMAC_KEY=__HMAC__
WARDEN_SCAN__SANDBOX_RUNTIME=runc
WARDEN_SCAN__SCRATCH_DIR=./.cache/scratch
WARDEN_SCAN__MIRROR_DIR=./.cache/mirror
