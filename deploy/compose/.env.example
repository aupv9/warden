# Production settings for docker-compose.prod.yml. Copy and fill with:
#   ../../scripts/gen-secrets.sh          (writes .env, mode 600)
# It replaces every CHANGE_ME with a random value and never prints them.
# Then set the values marked "edit". Warden refuses to start in prod with a
# placeholder secret, an http issuer or public URL, or runc.

# --- edit: names and image -------------------------------------------------
# The web UI and API (https://WARDEN_DOMAIN) and the bundled object store's
# public name for presigned uploads (profile s3). Both must resolve to this
# host; Caddy gets certificates for them.
WARDEN_DOMAIN=warden.example.com
WARDEN_S3_DOMAIN=s3.warden.example.com
ACME_EMAIL=admin@example.com
# A release image, by digest: ghcr.io/aupv9/warden@sha256:<digest from the release notes>
WARDEN_IMAGE=

# --- edit: identity provider (any OIDC provider; https) --------------------
WARDEN_OIDC__ISSUER=https://sso.example.com/realms/warden
WARDEN_OIDC__AUDIENCE=warden-api
# Public client of the web UI (authorization code + PKCE, redirect URI
# https://WARDEN_DOMAIN/). Optional audience parameter (Auth0).
WARDEN_WEB__OIDC_CLIENT_ID=warden-web
WARDEN_WEB__OIDC_SCOPE=openid profile email
WARDEN_WEB__OIDC_AUDIENCE=

# --- edit: mail ---------------------------------------------------------------
WARDEN_SMTP__HOST=smtp.example.com
WARDEN_SMTP__PORT=587
WARDEN_SMTP__FROM=warden@example.com
WARDEN_SMTP__USERNAME=
WARDEN_SMTP__PASSWORD=

# --- secrets (gen-secrets.sh) ---------------------------------------------------
POSTGRES_OWNER_PASSWORD=CHANGE_ME
WARDEN_APP_PASSWORD=CHANGE_ME
WARDEN_STORAGE__ACCESS_KEY=CHANGE_ME
WARDEN_STORAGE__SECRET_KEY=CHANGE_ME
WARDEN_SCAN__HMAC_KEY=CHANGE_ME
WARDEN_SECRETS__KEY=CHANGE_ME

# --- object storage -----------------------------------------------------------
# Bundled SeaweedFS (profile s3): keep the defaults. External S3: leave out
# profile s3, remove sites/s3.caddy, and set the endpoint, bucket and keys
# (the bucket needs CORS PUT from https://WARDEN_DOMAIN); PUBLIC_ENDPOINT only
# if browsers reach the store under another name than ENDPOINT.
WARDEN_STORAGE__BUCKET=warden-uploads
# WARDEN_STORAGE__ENDPOINT=https://s3.eu-west-1.amazonaws.com
# WARDEN_STORAGE__PUBLIC_ENDPOINT=

# --- scanner host (profile scanner, mirror) ----------------------------------------
# Group of /var/run/docker.sock on the scanner host (gen-secrets.sh fills it in).
DOCKER_GID=
# Same absolute path on the host and in the containers; owned by 65532.
WARDEN_SCRATCH_DIR=/srv/warden/scratch
WARDEN_MIRROR_DIR=/srv/warden/mirror
# Scanner images on the scanner host: ../../scripts/scanner-images.sh .env
WARDEN_SCAN__IMAGES__GITLEAKS=
WARDEN_SCAN__IMAGES__OPENGREP=
WARDEN_SCAN__IMAGES__TRIVY=
WARDEN_SCAN__IMAGES__CHECKOV=
WARDEN_SCAN__TIMEOUT=30m
WARDEN_SCAN__SLOTS_PER_NODE=7
# Worker on a separate scan VM: the core host's private address, and require TLS.
# WARDEN_DB_HOST=10.0.0.5
# WARDEN_DB_SSLMODE=require
# Core host with docker-compose.split.yml: its private address.
# POSTGRES_PRIVATE_BIND=10.0.0.5
