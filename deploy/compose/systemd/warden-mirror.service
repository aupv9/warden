# Refreshes Warden's offline scanner data (Trivy DB, rules, KEV/EPSS/OSV) on
# the host that runs warden-worker. Install on that host:
#   sudo cp warden-mirror.service warden-mirror.timer /etc/systemd/system/
#   sudo systemctl edit warden-mirror.service   # if the checkout isn't /opt/warden
#   sudo systemctl enable --now warden-mirror.timer
# A failed feed keeps its previous file and makes the unit fail (see
# `journalctl -u warden-mirror`); the worker keeps scanning with what it has.
[Unit]
Description=Warden offline scanner data sync
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
# The repository checkout that holds deploy/compose/.env.
WorkingDirectory=/opt/warden/deploy/compose
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml --profile mirror run --rm --build mirror
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
