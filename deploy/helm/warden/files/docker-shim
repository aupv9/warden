#!/bin/bash
# Stands in for `docker` in the mirror CronJob (see mirror-sync.sh). There is
# no Docker daemon or socket in Kubernetes: the only call sync-mirror.sh makes
# is the Trivy DB download, which the trivy-db init container has done.
for a in "$@"; do
  if [ "$a" = "--download-db-only" ]; then
    if [ -s "${MIRROR:?}/trivy/db/metadata.json" ]; then
      echo "    Trivy DB: fetched by the trivy-db init container"
      exit 0
    fi
    echo "docker-shim: no Trivy DB under $MIRROR/trivy" >&2
    exit 1
  fi
done
echo "docker-shim: Docker is not available in this Job (called as: docker $*)" >&2
exit 1
